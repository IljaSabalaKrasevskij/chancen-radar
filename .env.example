# ── LLM: lokales Ollama (kostenlos, laeuft auf deinem Rechner) ─────────────
# Standard braucht nichts zu aendern. Modell wird bei der Installation gezogen.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
# (Optional: statt lokal ein Cloud-Modell? Dann LLM_BASE_URL/LLM_MODEL/LLM_API_KEY
#  auf den Anbieter setzen, z.B. DeepSeek: base=https://api.deepseek.com/v1, key=sk-...)

# ── Firecrawl: Websuche nach Plattformen, Kooperationen, Ausschreibungen ───
# Eigenes Konto auf https://firecrawl.dev (Credits laufen ueber dieses Konto).
# Ohne Key laufen nur LinkedIn/Indeed. Pro Lauf je nach Suchbegriffen ca. 30-150 Credits.
FIRECRAWL_API_KEY=
# FIRECRAWL_SEARCH_LIMIT=8   # Treffer pro Suchanfrage
# FIRECRAWL_SCRAPE_MAX=12    # so viele neue Seiten werden ganz gelesen (1 Credit je Seite)

# ── ntfy.sh: Handy-Push bei neuen Jobs (siehe docs/NTFY-Anleitung.md) ──────
NTFY_TOPIC=chancen-radar-CHANGE-ME-RANDOM
APP_NAME=Chancen-Radar

# ── Dashboard-URL (nach Vercel-Deploy; leer = kein Klick-Link im Push) ─────
DASHBOARD_URL=

# ── Optional ──────────────────────────────────────────────────────────────
# PROFILE_FILE=profile.json
# LETTER_MIN_SCORE=70   # ab dieser Passung wird eine Nachricht vorbereitet

# JOBSPY_SITES=linkedin,indeed   # nur linkedin, falls Indeed im eigenen Netz blockiert
